{
  "schemaVersion": 1,
  "id": "goblinlabour",
  "version": "${version}",
  "name": "Goblin Labour",
  "description": "Craft goblins from rotten flesh, give them a straw bed and tools, and let them mine, dig and chop for you.",
  "authors": [
    "BaconCakeFactory"
  ],
  "contact": {
    "sources": "https://github.com/david-stefan-hermann/goblin-labour"
  },
  "license": "LGPL-2.1-only",
  "icon": "assets/goblinlabour/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "goblinlabour.GoblinLabour"
    ],
    "client": [
      "goblinlabour.client.GoblinLabourClient"
    ]
  },
  "mixins": [
    "goblinlabour.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "bcfguidebooklib": ">=1.0.0",
    "minecraft": "~26.2",
    "java": ">=25"
  }
}
