{
  "multipart": [
    {
      "apply": {
        "model": "goblinlabour:block/milk_can"
      }
    },
    {
      "when": {
        "level": "1|2|3"
      },
      "apply": {
        "model": "goblinlabour:block/milk_can_milk_1"
      }
    },
    {
      "when": {
        "level": "4|5|6"
      },
      "apply": {
        "model": "goblinlabour:block/milk_can_milk_2"
      }
    },
    {
      "when": {
        "level": "7|8|9"
      },
      "apply": {
        "model": "goblinlabour:block/milk_can_milk_3"
      }
    },
    {
      "when": {
        "level": "10"
      },
      "apply": {
        "model": "goblinlabour:block/milk_can_lid"
      }
    }
  ]
}
